{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RefundIssued",
  "type": "object",
  "properties": {
    "paymentId": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    }
  },
  "required": ["paymentId", "amount", "currency"],
  "examples": [
    {
      "paymentId": "pay_gbp",
      "amount": 5,
      "currency": "GBP"
    }
  ],
  "x-autocatalog": {
    "id": "refund.issued",
    "version": "1.0.0",
    "domain": "payments",
    "producers": ["PaymentService"],
    "consumers": ["LedgerService"],
    "transport": [
      {
        "address": "",
        "protocols": ["eventbridge"],
        "source": "payments",
        "detailType": "refund.issued",
        "identity": "payment-service"
      }
    ]
  }
}
