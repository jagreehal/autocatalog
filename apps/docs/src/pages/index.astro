---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { HomeHero, HomeSections } from '../components/Home';
import { LivingMap } from '../components/LivingMap';
import '../styles/home.css';

// The home page the plugin would otherwise generate is an index of documents.
// A project's front door has a different job: show every team's docs, events
// and services on one map, with where each fact came from. Only the map runs
// in the browser; the rest is static.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title: 'autocatalog',
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
    head: [],
  }}
>
  <div class="not-content" data-home>
    <section class="pt-2 lg:pt-8" aria-label="Introduction">
      <HomeHero base={base} />
      <div>
        <LivingMap client:idle />
      </div>
    </section>
    <HomeSections base={base} />
  </div>
</StarlightPage>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.copy ?? '');
      button.textContent = 'Copied';
      setTimeout(() => (button.textContent = 'Copy'), 1600);
    });
  }
</script>

<style is:global>
  /* Wider than Starlight's splash width, so the map has room; unlayered to win over it. */
  html:not([data-has-sidebar]):has([data-home]) {
    --sl-content-width: 85rem;
  }
  /*
   * Starlight prints the page title above the content. On the home page that is
   * the wordmark already sitting in the header, one line up. Hidden rather than
   * removed: #_top is where the skip link lands.
   */
  body:has([data-home]) h1#_top {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* Without the title, the panel that held it is an empty ruled band. */
  body:has([data-home]) .content-panel:first-of-type {
    padding-block: 0;
    border-bottom: 0;
  }
  body:has([data-home]) .content-panel {
    border-top: 0;
  }
  /* The title block's rule divides the title from the page; there is no title. */
  body:has([data-home]) [data-page-title] > [data-slot='separator'] {
    display: none;
  }
</style>
