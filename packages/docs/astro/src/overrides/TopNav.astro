---
import links from 'virtual:autocatalog-docs-nav';
import { navLinks } from '../nav';

interface Props {
  /** `header` beside the title from tablet width up; `menu` atop the phone menu. */
  variant?: 'header' | 'menu';
}

const { variant = 'header' } = Astro.props;

const views = navLinks(links, Astro.url.pathname, import.meta.env.BASE_URL);
---

{
  views.length > 0 && (
    <nav
      aria-label="Sections"
      class:list={[
        'ac-top-nav',
        `ac-top-nav--${variant}`,
        variant === 'header' ? 'sl-hidden md:sl-flex' : 'md:sl-hidden',
      ]}
      data-autocatalog-nav={variant}
    >
      <ul>
        {views.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
              rel={link.external ? 'external noopener' : undefined}
            >
              {link.label}
              {link.external && <span aria-hidden="true">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}
