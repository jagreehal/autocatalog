---
import links from 'virtual:autocatalog-docs-nav';
import { navLinks } from '../nav';

interface Props {
  /** `header` beside the title from tablet width up; `menu` atop the phone menu. */
  variant?: 'header' | 'menu';
}

const { variant = 'header' } = Astro.props;

const views = navLinks(links, Astro.url.pathname, import.meta.env.BASE_URL);
---

{
  views.length > 0 && (
    <nav
      aria-label="Sections"
      class:list={[
        'ac-top-nav',
        `ac-top-nav--${variant}`,
        variant === 'header' ? 'sl-hidden md:sl-flex' : 'md:sl-hidden',
      ]}
      data-autocatalog-nav={variant}
    >
      <ul>
        {views.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={link.current ? 'page' : undefined}
              rel={link.external ? 'external noopener' : undefined}
            >
              {link.label}
              {link.external && <span aria-hidden="true">↗</span>}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .ac-top-nav ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ac-top-nav a {
    display: inline-flex;
    gap: 0.25rem;
    align-items: center;
    padding: 0.375rem 0.625rem;
    border-radius: calc(var(--radius, 0.5rem) - 2px);
    color: var(--muted-foreground, var(--sl-color-gray-2));
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .ac-top-nav a:hover {
    background: var(--accent, var(--sl-color-gray-6));
    color: var(--accent-foreground, var(--sl-color-white));
  }

  .ac-top-nav a[aria-current='page'] {
    background: var(--accent, var(--sl-color-gray-6));
    color: var(--foreground, var(--sl-color-white));
  }

  .ac-top-nav a:focus-visible {
    outline: 2px solid var(--ring, var(--sl-color-accent));
    outline-offset: 2px;
  }

  .ac-top-nav--header {
    align-items: center;
    min-width: 0;
  }

  .ac-top-nav--menu {
    padding-block-end: 1rem;
    margin-block-end: 1rem;
    border-bottom: 1px solid var(--border, var(--sl-color-hairline));
  }

  .ac-top-nav--menu ul {
    flex-direction: column;
  }

  .ac-top-nav--menu a {
    width: 100%;
    font-size: var(--sl-text-base);
  }
</style>
