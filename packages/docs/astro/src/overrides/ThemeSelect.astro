---
import { SidebarControls } from '../ui/overrides/SidebarControls';
import { ThemeSelect } from '../ui/overrides/ThemeSelect';

// Theme stays in the header. The sidebar's collapse and resize mount here,
// outside `.sidebar-pane`, which collapsing hides. A splash page has no sidebar.
const { hasSidebar } = Astro.locals.starlightRoute;
---

<ThemeSelect client:load />
{
  hasSidebar && (
    <SidebarControls client:load />
  )
}
