---
import Default from '@astrojs/starlight/components/Footer.astro';
import { z } from 'astro/zod';
import { aboutDocument } from '../about';
import { docsCatalog, resourcesDefinedByRepository } from '../catalog';
import { chatPanel } from 'virtual:autocatalog-docs-build';
import { docsSiteConfig } from '../config';
import { SiteChat } from '../ui/overrides/SiteChat';
import ViewAs from './ViewAs.astro';
import { graphOwners, ownerFor, ownerHref } from '../owners';
import { DocFooterChrome } from '../ui/overrides/DocFooterChrome';
import { catalogHref, day, toLinks } from '../view';
import { catalogId } from '../ui/lib/docs';

// Starlight's route data. The index page this plugin injects renders without an
// entry from the docs collection, so every read here has to tolerate its
// absence.
const entry = Astro.locals.starlightRoute?.entry;

const id = entry ? catalogId(entry.id) : '';

// Starlight types the entry by its own schema, which knows nothing of the
// convention's fields. The collection already enforced these two, so this
// restates its types rather than trusting a cast.
const data = z
  .looseObject({ owner: z.string().optional(), related: z.array(z.string()).optional() })
  .parse(entry?.data ?? {});

const catalog = await docsCatalog();

const manifest = catalog.manifest;

const record = manifest[id];

// A decision, runbook or incident lists what it applies to in its title block.
const about = record?.kind ? [] : aboutDocument(catalog.graph, id);

const owner = record?.owner ?? data.owner;

const ownerPage = owner ? ownerFor(graphOwners(catalog.graph), owner) : undefined;

// Freshness is git's answer, not Starlight's: each enrolled repository may be
// its own checkout, which the site's own git history knows nothing about.
const changed = day(record?.updated);

const repository = id.split('/')[0] ?? '';

const defined = repository ? resourcesDefinedByRepository(catalog, repository) : [];

const { siteTitle } = Astro.locals.starlightRoute;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Owners, the repository and its files are the company's, not a reader's outside.
const outside = docsSiteConfig().audience !== undefined;
---

{
  chatPanel && (
    <SiteChat
      client:only="react"
      {...chatPanel}
      {...Astro.locals.chat}
      text={{ ...chatPanel.text, ...Astro.locals.chat?.text }}
      icons={{ ...chatPanel.icons, ...Astro.locals.chat?.icons }}
    />
  )
}

<ViewAs />

{outside ? <Default><slot /></Default> : (

<DocFooterChrome
  base={base}
  siteTitle={siteTitle}
  owner={owner}
  ownerHref={ownerPage && ownerHref(ownerPage)}
  known={record !== undefined}
  changed={changed}
  source={record?.source}
  edit={record?.edit}
  related={toLinks(data.related ?? [], manifest)}
  linkedFrom={toLinks(record?.linkedFrom ?? [], manifest)}
  about={about}
  repository={repository}
  defined={defined.map((resource) => ({
    kind: resource.ref.kind,
    id: resource.ref.id,
    title: resource.title,
    href: catalogHref(resource.ref),
  }))}
>
  <Default><slot /></Default>
</DocFooterChrome>
)}
