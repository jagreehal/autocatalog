---
// The header: title on the left, search in the middle, utilities on the right.
// The site's sections sit in the rail beside the sidebar, or after the title on
// a page with no sidebar.
import config from 'virtual:starlight/user-config';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import links from 'virtual:autocatalog-docs-nav';
import { navLinks } from '../nav';
import { SectionRail } from '../ui/overrides/SectionRail';
import TopNav from './TopNav.astro';

const { hasSidebar } = Astro.locals.starlightRoute;

const shouldRenderSearch =
  config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header ac-header">
  <div class="title-wrapper sl-flex">
    <SiteTitle />
    {!hasSidebar && <TopNav />}
  </div>
  <div class="sl-flex print:hidden middle">
    {shouldRenderSearch && <Search />}
  </div>
  <div class="sl-hidden md:sl-flex print:hidden right-group">
    <div class="sl-flex social-icons">
      <SocialIcons />
    </div>
    <ThemeSelect />
    <LanguageSelect />
  </div>
  {
    // Fixed beside the sidebar; mounted once, here, where Starlight renders the header once.
    hasSidebar && (
      <SectionRail links={navLinks(links, Astro.url.pathname, import.meta.env.BASE_URL)} />
    )
  }
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    gap: 1rem;
    align-items: center;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .middle {
    flex: 1;
    justify-content: center;
    min-width: 0;
    max-width: 36rem;
  }

  .middle :global(site-search),
  .middle :global(form[role='search']) {
    width: 100%;
  }

  .right-group,
  .social-icons {
    gap: 0.75rem;
    align-items: center;
  }

  .social-icons::after {
    content: '';
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: minmax(10rem, 1fr) minmax(16rem, 36rem) minmax(10rem, 1fr);
      align-content: center;
      column-gap: 1rem;
    }

    .middle {
      justify-self: stretch;
      max-width: none;
    }

    .right-group {
      justify-self: end;
    }
  }
</style>
