---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { z } from 'astro/zod';
import { docsCatalog } from '../catalog';
import { kindHeader } from '../kinds';
import {
  COPY_MARKDOWN_LABEL,
  type PageAction,
  pageHeader,
  resourceContext,
  withMarkdownCopy,
} from '../shell';
import { PageTitleChrome } from '../ui/overrides/PageTitleChrome';
import { docHref } from '../view';

// The head of every page: its title, its key in the catalog, the sentence that
// says what it is for, then what a reader can do with the page itself.
// A resource page says so through its context; a document is recognised by
// its id being in the manifest. The markup is React; Starlight's own <h1> is
// Astro, so it is handed in as the chrome's children.
const { id, entry } = Astro.locals.starlightRoute;

const resource = resourceContext(Astro.locals);

const header = pageHeader(Astro.locals);

const catalog = await docsCatalog();

const isDoc = !resource && id in catalog.manifest;

// A decision, runbook or incident says so, with its state and what it applies to.
const record = isDoc
  ? kindHeader(catalog, id, import.meta.env.BASE_URL.replace(/\/?$/, '/'))
  : undefined;

const kind = resource?.kind ?? (isDoc ? 'doc' : undefined);

const kindLabel =
  record?.kind.label ??
  (kind === 'doc' ? 'Document' : kind && kind.charAt(0).toUpperCase() + kind.slice(1));

// A document's convention field is `summary`; Starlight's own is `description`.
// Starlight types the entry by its own schema, so the convention's field is
// restated here; the collection already enforced it.
const data = z
  .looseObject({ description: z.string().optional(), summary: z.string().optional() })
  .parse(entry.data);

// Every document has a Markdown twin; a resource page lists its own. Pages that
// already passed Copy/View through the header keep them; a lone View is raised
// to the pair every twin-backed page shows.
const listed = header?.actions ?? [];

const view = listed.find((action) => action.label === 'View as Markdown');

const actions: PageAction[] = isDoc
  ? withMarkdownCopy(docHref(`${id}.md`), listed)
  : view && !listed.some((action) => action.label === COPY_MARKDOWN_LABEL)
    ? withMarkdownCopy(view.href, listed)
    : listed;
---

<PageTitleChrome
  client:load
  kind={kind}
  kindLabel={kindLabel}
  catalogKey={resource?.key ?? (isDoc ? `document:${id}` : undefined)}
  primary={header?.primary}
  title={entry.data.title}
  summary={data.description ?? data.summary}
  pills={resource?.pills ?? []}
  status={record?.status}
  facts={record?.facts}
  actions={actions}
>
  <Default />
</PageTitleChrome>
