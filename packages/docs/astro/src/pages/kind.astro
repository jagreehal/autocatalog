---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import { readableCatalog } from '../access';
import { docsCatalog } from '../catalog';
import { kindIndexProps } from '../kinds';
import { KindIndexPage } from '../ui/pages/KindIndexPage';

// One index per kind with documents, at the path its conventions give it:
// every decision, runbook or incident across every repository.
export async function getStaticPaths() {
  const catalog = await docsCatalog();

  return catalog.kinds.map((kind) => ({ params: { kind: kind.path }, props: { kind } }));
}

type Props = Partial<InferGetStaticPropsType<typeof getStaticPaths>>;

const catalog = await docsCatalog();

// On a site with `access` each kind has a route of its own, rendered per
// request, and lists only what this reader may open.
const kind =
  Astro.props.kind ?? catalog.kinds.find((each) => `/${each.path}` === Astro.routePattern);

if (!kind) return Astro.rewrite('/404');

const page = kindIndexProps(readableCatalog(catalog, Astro.locals.canRead), kind);
---

<StarlightPage
  frontmatter={{
    title: kind.label,
    description:
      kind.description ??
      `Every document under docs/${kind.folder}/ in every enrolled repository, newest first.`,
    tableOfContents: false,
  }}
>
  <KindIndexPage client:load {...page} />
</StarlightPage>
