---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import { docsCatalog } from '../catalog';
import { buildDomains } from '../domains';
import { renderNarrative } from '../flows';
import { domainPageProps } from '../page-models';
import { setResourceContext } from '../shell';
import { DomainPage } from '../ui/pages/DomainPage';

// A domain has no page of its own to author: it is whatever its events and services name.
export async function getStaticPaths() {
  const catalog = await docsCatalog();
  const domains = buildDomains(catalog.events, catalog.graph);

  return domains.map((domain) => ({ params: { domain: domain.name }, props: { domain } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { domain } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const { overview, ...page } = domainPageProps(await docsCatalog(), domain, base);

setResourceContext(Astro.locals, {
  kind: 'domain',
  name: domain.name,
  key: `domain:${domain.name}`,
  pills: [],
});

const narrativeHtml = overview ? await renderNarrative(overview) : null;

// The page's sections, for Starlight's "On this page", in the order they render.
const sections: Array<[string, string, number]> = [
  ['subdomains', 'Subdomains', page.subdomains.length],
  ['systems', 'Systems', page.systems.length],
  ['services', 'Services', page.services.length],
  ['events', 'Events', page.events.length],
  ['contracts', 'Contracts', page.contracts.length],
  ['entities', 'Entities', page.entities.length],
  ['flows', 'Flows', page.flows.length],
  ['documents', 'Guides and runbooks', page.documents.length],
  ['owners', 'Owners', page.owners.length],
];

const headings = sections.flatMap(([slug, text, count]) =>
  count > 0 ? [{ depth: 2, slug, text }] : [],
);
---

<StarlightPage
  frontmatter={{
    title: page.title,
    description:
      page.summary ??
      'Built from the events and services that name this domain, so it changes when they do.',
  }}
  headings={headings}
>
  {narrativeHtml && <div set:html={narrativeHtml} />}
  <DomainPage client:load {...page} />
</StarlightPage>
