---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { docsCatalog } from '../catalog';
import { ownersPageProps } from '../page-models';
import { OwnersPage } from '../ui/pages/OwnersPage';

const catalog = await docsCatalog();

---

<StarlightPage
  frontmatter={{
    title: 'Owners',
    description:
      'The teams that own the catalog, and what each one owns. A resource names its owner, a connected service catalog does, or CODEOWNERS does for the file it was read from.',
    tableOfContents: false,
  }}
>
  <OwnersPage {...ownersPageProps(catalog)} />
</StarlightPage>
