---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import { docsCatalog, eventParticipants } from '../catalog';
import { eventPageProps } from '../page-models';
import { eventPath } from '../event-path';
import { statusPills } from '../resource-status';
import { setResourceContext, withMarkdownCopy } from '../shell';
import { twinPath } from '../twins';
import { EventPage } from '../ui/pages/EventPage';

export async function getStaticPaths() {
  const catalog = await docsCatalog();

  return catalog.events.map(({ repository, event }) => ({
    params: { repository, domain: event.frontmatter.domain, id: event.frontmatter.id },
    props: { repository, event },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { repository, event } = Astro.props;

const catalog = await docsCatalog();

const fm = event.frontmatter;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// Agents, Tools and services in other repositories name the events they touch
// in their own repositories, so they are read from the composed graph rather
// than from this event's frontmatter.
const agents = eventParticipants(catalog, repository, event);

const page = await eventPageProps(catalog, Astro.props, agents, base);

const markdownHref = `${base}${twinPath(eventPath(Astro.props))}`;

setResourceContext(Astro.locals, {
  kind: 'event',
  name: fm.name,
  key: `event:${fm.domain}/${fm.id}`,
  actions: withMarkdownCopy(markdownHref, [
    { label: 'Copy schema', href: page.schemaHref, icon: 'copy', copy: true },
    { label: 'View schema.json', href: page.schemaHref, icon: 'braces' },
  ]),
  pills: [
    ...statusPills({
      status: fm.status,
      version: fm.version,
      needsReview: fm.needsReview,
    }),
    ...(fm.classification ? [{ text: fm.classification }] : []),
    // The labels a team gave the event. Shown in the theme's colours rather
    // than the ones written beside them, so every badge reads the same way.
    ...fm.badges.map((badge) => ({ text: badge.content })),
  ],
});

// The page's sections, for Starlight's "On this page".
const headings = [
  { depth: 2, slug: 'schema', text: 'Schema' },
  { depth: 2, slug: 'runtime', text: 'Runtime evidence' },
  ...(page.examples.length ? [{ depth: 2, slug: 'examples', text: 'Examples' }] : []),
  ...(page.versions.length > 1 ? [{ depth: 2, slug: 'versions', text: 'Versions' }] : []),
  ...(page.records ?? []).map(({ id, heading }) => ({ depth: 2, slug: id, text: heading })),
  ...(page.documents.length ? [{ depth: 2, slug: 'documents', text: 'Documents' }] : []),
  { depth: 2, slug: 'details', text: 'Details' },
  ...(page.diagram ? [{ depth: 2, slug: 'diagram', text: 'Diagram' }] : []),
];
---

<StarlightPage
  frontmatter={{
    title: fm.name,
    description: fm.summary,
    head: [{ tag: 'link', attrs: { rel: 'alternate', type: 'text/markdown', href: markdownHref } }],
  }}
  headings={headings}
>
  <EventPage client:load {...page} />
</StarlightPage>
