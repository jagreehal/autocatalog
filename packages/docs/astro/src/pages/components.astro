---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { docsCatalog } from '../catalog';
import { componentRows } from '../page-models';
import { ComponentsPage } from '../ui/pages/ComponentsPage';

const catalog = await docsCatalog();

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
  frontmatter={{
    title: 'Components',
    description: 'Every UI component teams publish.',
    tableOfContents: false,
  }}
>
  <ComponentsPage components={componentRows(catalog, base)} />
</StarlightPage>
