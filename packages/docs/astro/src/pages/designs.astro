---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { docsCatalog } from '../catalog';
import { designsPageProps } from '../designs';
import { DesignsPage } from '../ui/pages/DesignsPage';
import { NewDesign } from '../ui/pages/NewDesign';

const catalog = await docsCatalog();

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
  frontmatter={{
    title: 'Designs',
    description: 'The architecture each repository proposes under designs/, against the catalog.',
    tableOfContents: false,
  }}
>
  {
    import.meta.env.DEV && (
      <NewDesign
        client:load
        repositories={Object.keys(catalog.repositoryRoots).sort()}
        startUrl={`${base}designs/new.json`}
      />
    )
  }
  <DesignsPage {...designsPageProps(catalog.designs, base)} />
</StarlightPage>
