---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { docsCatalog } from '../catalog';
import { catalogPageProps } from '../page-models';
import { CatalogPage } from '../ui/pages/CatalogPage';

const catalog = await docsCatalog();


const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
  frontmatter={{
    title: 'Knowledge graph',
    description:
      'One index compiled from repository conventions. Every row keeps its source, confidence, and connections.',
    tableOfContents: false,
  }}
>
  <CatalogPage client:load {...catalogPageProps(catalog, base)} />
</StarlightPage>
