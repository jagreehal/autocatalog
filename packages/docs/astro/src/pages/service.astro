---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import { catalogServices } from '../apis';
import { docsCatalog } from '../catalog';
import { renderNarrative } from '../flows';
import { serviceBasis, serviceFacts, servicePageProps } from '../page-models';
import { setResourceContext, withMarkdownCopy } from '../shell';
import { twinPath } from '../twins';
import { ServicePage } from '../ui/pages/ServicePage';

// A service has no page of its own to author: it is whatever the events say
// produces and consumes them, and the APIs that name it.
export async function getStaticPaths() {
  const catalog = await docsCatalog();
  const services = catalogServices(catalog);

  return [...services.values()].map((service) => ({
    params: { name: service.name },
    props: { service },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { service } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const catalog = await docsCatalog();

const page = servicePageProps(catalog, service, base);

const facts = serviceFacts(catalog.graph, service.name);

// The team's own words about it, from `overviews/services/<name>.md`, above what the catalog says.
const overview = catalog.overviews.find(
  ({ kind, target }) => kind === 'service' && target === service.name,
);

const narrativeHtml = overview?.body ? await renderNarrative(overview.body) : null;

const markdownHref = `${base}${twinPath(`services/${service.name}/`)}`;

setResourceContext(Astro.locals, {
  kind: 'service',
  name: service.name,
  key: `service:${service.name}`,
  actions: withMarkdownCopy(markdownHref, (facts.repository
      ? [{ label: 'Repository', href: facts.repository, icon: 'repository' as const }]
      : [])),
  pills: [],
});

// The page's sections, for Starlight's "On this page".
const headings = [
  ...page.sections.map(({ heading, slug }) => ({ depth: 2, slug, text: heading })),
  ...(page.apis?.length ? [{ depth: 2, slug: 'apis', text: 'APIs and specifications' }] : []),
  ...(page.records ?? []).map(({ id, heading }) => ({ depth: 2, slug: id, text: heading })),
  ...(page.documents.length ? [{ depth: 2, slug: 'documents', text: 'Documents' }] : []),
  ...(page.diagram ? [{ depth: 2, slug: 'diagram', text: 'Diagram' }] : []),
];
---

<StarlightPage
  frontmatter={{
    title: service.name,
    head: [{ tag: 'link', attrs: { rel: 'alternate', type: 'text/markdown', href: markdownHref } }],
    // Its own summary when it has one; else what the page is, since nobody wrote it.
    description: overview?.summary ?? facts.summary ?? serviceBasis(catalog, service.name).description,
  }}
  headings={headings}
>
  {narrativeHtml && <div set:html={narrativeHtml} />}
  <ServicePage client:load {...page} />
</StarlightPage>
