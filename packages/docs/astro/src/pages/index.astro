---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getCollection } from 'astro:content';
import { defaultHomeLayout, repositoryMetas } from 'autocatalog-docs-core';
import { apiOperations, apiPath, apiSummary, apiTitle } from '../apis';
import { readableCatalog } from '../access';
import { docsCatalog } from '../catalog';
import { docsSiteConfig } from '../config';
import { homePageProps } from '../page-models';
import { setPageHeader } from '../shell';
import { blockIds, HomeBlock } from '../ui/pages/HomeBlock';
import { resolveHomeLayout } from '../home-layout';
import blocks from 'virtual:autocatalog-docs-blocks';
import { listItems } from '../view';
import { catalogId } from '../ui/lib/docs';

// Starlight has no page at / until some repository publishes docs/index.md, and
// no single team should have to own the company's front door.
const site = docsSiteConfig();

// On a site with `access` this renders per request, with what this reader may open.
const { canRead } = Astro.locals;

const catalog = readableCatalog(await docsCatalog(), canRead);

const items = listItems(
  (await getCollection('docs')).filter((entry) => catalogId(entry.id) in catalog.manifest),
  catalog.manifest,
);

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const home = homePageProps(
  catalog,
  items,
  base,
  repositoryMetas(site.root, { repo: site.repo, repository: site.repository }),
  { counts: site.homeCounts, outside: Boolean(site.audience) },
);

// Readers outside start from the references and the guides, not the catalog.

const page = site.audience
  ? {
      ...home,
      stats: [],
      attention: undefined,
      explore: [
        ...catalog.apis.map((api) => ({
          title: apiTitle(api),
          text:
            apiSummary(api) ?? `${apiOperations(api).length} operations, with examples.`,
          href: `${base}${apiPath(api)}`,
          icon: 'api' as const,
        })),
        ...home.explore.filter((card) => card.kind === 'doc'),
        {
          title: 'For agents',
          text: 'llms.txt, a Markdown twin of every guide, and each API as openapi.json.',
          href: `${base}llms.txt`,
          icon: 'braces' as const,
        },
      ],
    }
  : home;

const metas = repositoryMetas(site.root, { repo: site.repo, repository: site.repository });

// The page is its layout: `layouts.home`, or the default, which is the built-in
// page `ac site --print-layout home` prints. A site for an audience that names
// the counts, the map or the attention list fails the build before this.
const layout = resolveHomeLayout(site.layouts?.home ?? defaultHomeLayout(site), {
  base,
  stats: (kinds) =>
    kinds
      ? homePageProps(catalog, items, base, metas, { counts: kinds, outside: false }).stats
      : page.stats,
  documents: items,
  repos: page.repos,
  apis: catalog.apis.map((api) => ({
    title: apiTitle(api),
    text: apiSummary(api) ?? `${apiOperations(api).length} operations, with examples.`,
    href: `${base}${apiPath(api)}`,
    icon: 'api' as const,
  })),
  explore: page.explore,
  tags: page.tags,
  attention: page.attention,
  map: page.map,
  catalogHref: page.catalogHref,
});

const ids = blockIds(layout.map((entry) => ({ block: entry.custom ? entry.name : entry.data.block })));

setPageHeader(
  Astro.locals,
  site.audience
    ? {
        ...(catalog.apis.length > 0 && {
          primary: { label: 'API reference', href: `${base}apis/` },
        }),
      }
    : { eyebrow: 'Catalog', primary: { label: 'Explore catalog', href: `${base}catalog/` } },
);
---

<StarlightPage
  frontmatter={{
    title: site.title,
    description: site.description,
    tableOfContents: false,
    // Starlight titles pages "<page> | <site>"; the home page is the site, so name it once.
    head: [{ tag: 'title', content: site.title }],
  }}
>
  <div class="not-content flex flex-col gap-10" data-wide>
    {
      layout.map((entry, index) => {
        if (!entry.custom) return <HomeBlock client:load block={entry.data} id={ids[index]!} />;

        const Block = blocks[entry.name];

        return Block ? <Block {...entry.props} /> : null;
      })
    }
  </div>
</StarlightPage>
