---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { docsCatalog } from '../catalog';
import { systemsPageProps } from '../page-models';
import { SystemsPage } from '../ui/pages/SystemsPage';

const catalog = await docsCatalog();

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
  frontmatter={{
    title: 'Systems',
    description: 'Systems and external systems named in designs.',
    tableOfContents: false,
  }}
>
  <SystemsPage {...systemsPageProps(catalog, base)} />
</StarlightPage>
