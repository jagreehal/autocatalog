---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { docsCatalog } from '../catalog';
import { glossaryPageProps } from '../model';
import { eventPages, servicePages } from '../page-models';
import { GlossaryPage } from '../ui/pages/GlossaryPage';

const catalog = await docsCatalog();

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<StarlightPage
  frontmatter={{
    title: 'Glossary',
    description: 'Each domain’s ubiquitous language, from the glossary/ each repository keeps.',
    tableOfContents: false,
  }}
>
  <GlossaryPage
    {...glossaryPageProps(catalog, base, {
      servicePages: servicePages(catalog),
      eventPages: eventPages(catalog),
    })}
  />
</StarlightPage>
