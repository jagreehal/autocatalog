---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import { apiDescription, apiPageProps, apiPath, apiTitle, servicesForApi } from '../apis';
import { docsCatalog } from '../catalog';
import { docsSiteConfig } from '../config';
import { setPageHeader } from '../shell';
import { ApiPage } from '../ui/pages/ApiPage';

export async function getStaticPaths() {
  const catalog = await docsCatalog();

  return catalog.apis.map((api) => ({
    params: { repository: api.repository, name: api.name },
    props: { api },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { api } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const catalog = await docsCatalog();

const site = docsSiteConfig();

const outside = site.audience !== undefined;

// Full, Scalar's sidebar is the navigation, so the site's steps aside. Framed,
// both stay: the site's beside the frame, Scalar's within it.
const full = site.apiReference === 'full';

const page = outside
  ? apiPageProps(api, [], base, true)
  : apiPageProps(api, servicesForApi(api, catalog.events), base);

setPageHeader(Astro.locals, {
  actions: [{ label: 'View openapi.json', href: page.specHref, icon: 'braces' }],
});
---

<StarlightPage
  frontmatter={{
    title: apiTitle(api),
    description:
      apiDescription(api) ??
      (outside ? 'The API reference.' : `The OpenAPI reference ${api.repository} commits at ${api.file}.`),
    tableOfContents: false,
  }}
  hasSidebar={!full}
>
  <ApiPage
    client:load
    {...page}
    layout={site.apiReference}
    referenceHref={`${base}${apiPath(api)}reference/`}
    title={`${apiTitle(api)} reference`}
    mcp={process.env.AUTOCATALOG_SITE_MCP_ENDPOINT
      ? { name: site.title, path: `${base}${process.env.AUTOCATALOG_SITE_MCP_ENDPOINT}` }
      : undefined}
  />
</StarlightPage>
