---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import type { InferGetStaticPropsType } from 'astro';
import { docsCatalog } from '../catalog';
import { renderNarrative } from '../flows';
import { catalogSystems, systemPageProps } from '../page-models';
import { setResourceContext } from '../shell';
import { SystemPage } from '../ui/pages/SystemPage';

export async function getStaticPaths() {
  const catalog = await docsCatalog();
  const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

  return catalogSystems(catalog, base).map((system) => ({
    params: { id: system.id },
    props: { id: system.id },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { id } = Astro.props;

const catalog = await docsCatalog();

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const page = systemPageProps(catalog, id, base);

if (!page) throw new Error(`system not found: ${id}`);

// The team's own words about it, from `overviews/systems/<id>.md`.
const overview = catalog.overviews.find(({ kind, target }) => kind === 'system' && target === id);

const narrativeHtml = overview?.body ? await renderNarrative(overview.body) : null;

setResourceContext(Astro.locals, {
  kind: 'domain',
  name: page.system.name,
  key: `system:${page.system.id}`,
  pills: [{ text: page.system.external ? 'external' : 'system', tone: 'quiet' }],
});
---

<StarlightPage
  frontmatter={{
    title: page.system.name,
    description: overview?.summary ?? page.system.summary ?? page.system.design?.title,
    tableOfContents: false,
  }}
>
  {narrativeHtml && <div set:html={narrativeHtml} />}
  <SystemPage {...page} />
</StarlightPage>
