{
  "name": "autocatalog-docs-astro",
  "version": "0.5.0",
  "description": "Starlight plugin that reads every repository's docs/ instead of one src/content/docs, and publishes markdown twins and llms.txt alongside.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autocatalog.git",
    "directory": "packages/docs/astro"
  },
  "homepage": "https://jagreehal.github.io/autocatalog",
  "bugs": {
    "url": "https://github.com/jagreehal/autocatalog/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./content.config": "./src/content.config.ts",
    "./overrides/*": "./src/overrides/*",
    "./pages/*": "./src/pages/*",
    "./styles/*": "./src/styles/*",
    "./ui/*": "./src/ui/*",
    "./icons": "./src/icons.ts",
    "./site/*": "./site/*",
    "./route-middleware": "./src/route-middleware.ts"
  },
  "imports": {
    "#ui/*": "./src/ui/*"
  },
  "files": [
    "README.md",
    "site",
    "src",
    "!src/**/*.stories.tsx",
    "!src/**/fixtures.ts"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.41.0",
    "astro": "^7.0.2"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/react": "7.0.1",
    "@eventcatalog/visualiser": "5.1.2",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.3.3",
    "autocatalog-agents-core": "workspace:*",
    "autocatalog-core": "workspace:*",
    "autocatalog-docs-core": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "1.55.0",
    "microlighter": "2.2.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.42.6",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "^8.20.0",
    "astro": "^7.3.8",
    "jsdom": "27.0.1",
    "storybook": "10.6.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  }
}
