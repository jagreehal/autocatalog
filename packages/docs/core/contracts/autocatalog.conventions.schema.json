{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "const": "event"
          },
          "files": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "match": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "kind",
          "files",
          "match",
          "domain"
        ],
        "additionalProperties": false
      }
    },
    "kinds": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean",
            "const": false
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "folder": {
                "type": "string",
                "pattern": "^[\\w-]+(?:\\/[\\w-]+)*$"
              },
              "path": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "description": {
                "type": "string"
              },
              "schema": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "$ref": "#/$defs/__schema0"
                }
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "statusField": {
                "type": "string",
                "minLength": 1
              },
              "dateField": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
