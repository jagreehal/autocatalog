{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "brand": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "enum": [
        "teal",
        "blue",
        "orange",
        "green",
        "purple"
      ]
    },
    "navigation": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "collapsed": {
                "type": "boolean"
              },
              "items": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "href": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "label",
                        "href"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "label",
              "items"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "groups"
      ],
      "additionalProperties": false
    },
    "extend": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "chat": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "suggestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "support": {
          "type": "object",
          "properties": {
            "api": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "api"
          ],
          "additionalProperties": false
        },
        "text": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "icons": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "side": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ]
        },
        "panel": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "module",
        "title"
      ],
      "additionalProperties": false
    },
    "access": {
      "type": "object",
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1
        },
        "denied": {
          "type": "string",
          "enum": [
            "hide",
            "teaser"
          ]
        }
      },
      "required": [
        "module"
      ],
      "additionalProperties": false
    },
    "repo": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "atRoot": {
      "type": "boolean"
    },
    "pages": {
      "type": "string",
      "minLength": 1
    },
    "pageActions": {
      "type": "boolean"
    },
    "apiReference": {
      "type": "string",
      "enum": [
        "full",
        "embedded"
      ]
    },
    "mcp": {
      "type": "boolean"
    },
    "output": {
      "type": "string",
      "enum": [
        "static",
        "server"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "required": [
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "social": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "icon": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "icon",
          "label",
          "href"
        ],
        "additionalProperties": false
      }
    },
    "head": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string",
            "enum": [
              "title",
              "base",
              "link",
              "style",
              "meta",
              "script",
              "noscript",
              "template"
            ]
          },
          "attrs": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "boolean"
              ]
            }
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "tag"
        ],
        "additionalProperties": false
      }
    },
    "strings": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
