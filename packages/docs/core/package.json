{
  "name": "autocatalog-docs-core",
  "version": "0.3.0",
  "description": "Aggregate repository-owned docs/ roots into one validated, linkable index.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autocatalog.git",
    "directory": "packages/docs/core"
  },
  "homepage": "https://jagreehal.github.io/autocatalog",
  "bugs": {
    "url": "https://github.com/jagreehal/autocatalog/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autocatalog-core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
