{
  "name": "autocatalog-chatbot",
  "version": "0.1.0",
  "description": "An assistant for a docs site that answers only from the pages it may read, with the AI SDK and shadcn/ui.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autocatalog.git",
    "directory": "packages/docs/chatbot"
  },
  "homepage": "https://jagreehal.github.io/autocatalog",
  "bugs": {
    "url": "https://github.com/jagreehal/autocatalog/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "imports": {
