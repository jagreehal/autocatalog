    "cn": "0.4.0",
    "lucide-react": "1.55.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.36",
    "@testing-library/react": "16.3.2",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "27.0.1",
    "shadcn": "4.21.4",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "test": "vitest run"
  }
