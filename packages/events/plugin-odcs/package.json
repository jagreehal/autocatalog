{
  "name": "autocatalog-plugin-odcs",
  "version": "0.0.0",
  "description": "ac from-odcs: put Open Data Contract Standard (ODCS) contracts on the company site as tables with their schema, and gate pull requests on breaking changes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jagreehal/autocatalog.git",
    "directory": "packages/events/plugin-odcs"
  },
  "homepage": "https://jagreehal.github.io/autocatalog",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "autocatalog-from-odcs": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "autocatalog": {
    "plugin": {
      "command": "from-odcs",
      "description": "Read ODCS data contracts (*.odcs.yaml) into the catalog's tables",
      "entry": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run"
  },
  "dependencies": {
    "autocatalog-core": "workspace:*",
    "autocatalog-docs-core": "workspace:*",
    "autotel-datacontract": "^0.1.0",
    "commander": "^15.0.0",
    "kleur": "^4.1.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
