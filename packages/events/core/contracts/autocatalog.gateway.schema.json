{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "gateway": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][\\w.:-]{0,199}$"
    },
    "source": {
      "type": "string"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][\\w.:-]{0,199}$"
          },
          "service": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][\\w.-]{0,199}$"
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^\\/[!-~]{0,400}$"
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[!-~]{1,400}$"
            }
          },
          "methods": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "GET",
                "PUT",
                "POST",
                "DELETE",
                "PATCH",
                "OPTIONS",
                "HEAD",
                "TRACE"
              ]
            }
          },
          "stripPath": {
            "default": false,
            "type": "boolean"
          },
          "upstreamPath": {
            "type": "string",
            "pattern": "^\\/[!-~]{0,400}$"
          },
          "auth": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][\\w.:-]{0,199}$"
            }
          }
        },
        "required": [
          "name",
          "service"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "gateway",
    "routes"
  ],
  "additionalProperties": false
}
