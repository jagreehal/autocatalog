{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec": {
      "default": "autocatalog/v2",
      "type": "string",
      "const": "autocatalog/v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string"
    },
    "owner": {
      "type": "object",
      "properties": {
        "team": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "contact": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "team"
      ]
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "draft"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "internal",
        "domain",
        "integration",
        "public"
      ]
    },
    "producers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "consumerFields": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "badges": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "content": {
            "type": "string"
          },
          "backgroundColor": {
            "type": "string"
          },
          "textColor": {
            "type": "string"
          }
        },
        "required": [
          "content"
        ]
      }
    },
    "schema": {
      "default": "./schema.json",
      "type": "string"
    },
    "examples": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deprecation": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string"
        },
        "replacedBy": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "since"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "code",
            "github_clone",
            "url"
          ]
        },
        "repo": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "schema": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "symbol": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "transport": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "protocols": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "deliveryMode": {
            "type": "string",
            "enum": [
              "push",
              "pull",
              "push-pull"
            ]
          },
          "routingKey": {
            "type": "string"
          },
          "headers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "identity": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "detailType": {
            "type": "string"
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "guarantee": {
          "type": "string",
          "enum": [
            "at-least-once",
            "at-most-once",
            "exactly-once"
          ]
        },
        "orderingKey": {
          "type": "string",
          "minLength": 1
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1
        },
        "correlationKey": {
          "type": "string",
          "minLength": 1
        },
        "maxLateness": {
          "type": "string"
        }
      }
    },
    "envelope": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "cloudevents"
        },
        "mode": {
          "default": "structured",
          "type": "string",
          "enum": [
            "structured",
            "binary"
          ]
        },
        "specversion": {
          "default": "1.0",
          "type": "string",
          "const": "1.0"
        }
      },
      "required": [
        "type"
      ]
    },
    "provenance": {
      "default": {
        "default": "declared",
        "fields": {}
      },
      "type": "object",
      "properties": {
        "default": {
          "default": "declared",
          "type": "string",
          "enum": [
            "declared",
            "extracted",
            "inferred",
            "overridden",
            "observed"
          ]
        },
        "fields": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "declared",
              "extracted",
              "inferred",
              "overridden",
              "observed"
            ]
          }
        }
      }
    },
    "observed": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "firstSeen": {
          "type": "string"
        },
        "lastSeen": {
          "type": "string"
        },
        "consumers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "producers": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sampleTraceIds": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "producer": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "firstSeen": {
                "type": "string"
              },
              "lastSeen": {
                "type": "string"
              }
            },
            "required": [
              "count",
              "firstSeen",
              "lastSeen"
            ]
          }
        },
        "consumerOutcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "consumer": {
                "type": "string"
              },
              "channel": {
                "type": "string"
              },
              "count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "retried": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deadLettered": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "replayed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "deadLetterReasons": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "reason": {
                      "type": "string",
                      "maxLength": 200
                    },
                    "category": {
                      "type": "string"
                    },
                    "queue": {
                      "type": "string"
                    },
                    "count": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "reason",
                    "count"
                  ]
                }
              }
            },
            "required": [
              "consumer",
              "count"
            ]
          }
        },
        "fieldPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fieldTypes": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "declaredConsumers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "consumerEvidence": {
          "type": "string",
          "enum": [
            "reported",
            "observed",
            "unknown"
          ]
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "spec": {
              "type": "string"
            },
            "generatedAt": {
              "type": "string"
            }
          },
          "required": [
            "spec",
            "generatedAt"
          ]
        }
      },
      "required": [
        "count",
        "firstSeen",
        "lastSeen",
        "snapshot"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needsReview": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "version",
    "name",
    "summary"
  ]
}
