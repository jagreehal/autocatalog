{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "confidence": {
          "default": "inferred",
          "type": "string",
          "enum": [
            "inferred",
            "reviewed"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "line"
            ]
          }
        },
        "needs_review": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "adapter"
      ]
    },
    "kind": {
      "default": "agent",
      "type": "string",
      "const": "agent"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "tools": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "servers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "domain": {
      "type": "string"
    },
    "risk": {
      "default": "medium",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "prompts": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "system"
      ]
    },
    "expected_traffic": {
      "type": "object",
      "properties": {
        "invocations_per_day": {
          "type": "number",
          "minimum": 0
        },
        "avg_input_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "avg_output_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "invocations_per_day",
        "avg_input_tokens",
        "avg_output_tokens"
      ]
    },
    "produces": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consumes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "minLength": 1
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "event"
        ]
      }
    }
  },
  "required": [
    "name",
    "owner",
    "model"
  ]
}
