{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "confidence": {
          "default": "inferred",
          "type": "string",
          "enum": [
            "inferred",
            "reviewed"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "line"
            ]
          }
        },
        "needs_review": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "adapter"
      ]
    },
    "kind": {
      "default": "workflow",
      "type": "string",
      "const": "workflow"
    },
    "agents": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "flow": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "on": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    },
    "domain": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "owner",
    "agents"
  ]
}
