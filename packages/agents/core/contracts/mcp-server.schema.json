{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "confidence": {
          "default": "inferred",
          "type": "string",
          "enum": [
            "inferred",
            "reviewed"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "line"
            ]
          }
        },
        "needs_review": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "adapter"
      ]
    },
    "kind": {
      "default": "mcp-server",
      "type": "string",
      "const": "mcp-server"
    },
    "origin": {
      "default": "unknown",
      "type": "string",
      "enum": [
        "built",
        "third-party",
        "unknown"
      ]
    },
    "transport": {
      "type": "string",
      "enum": [
        "stdio",
        "http"
      ]
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "package": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string",
          "enum": [
            "npm",
            "pypi",
            "oci"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "registry",
        "name"
      ]
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "versions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "used_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "string",
          "minLength": 1
        },
        "integration": {
          "type": "string",
          "minLength": 1
        },
        "headers": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
          }
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "\\$\\{[A-Za-z_][A-Za-z0-9_]*\\}"
          }
        },
        "command": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "name",
    "owner",
    "transport"
  ]
}
