{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "confidence": {
          "default": "inferred",
          "type": "string",
          "enum": [
            "inferred",
            "reviewed"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "line"
            ]
          }
        },
        "needs_review": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "adapter"
      ]
    },
    "kind": {
      "default": "agent-plugin",
      "type": "string",
      "const": "agent-plugin"
    },
    "marketplace": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "agents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "commands": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hooks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "servers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "enabled_in": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "used_by": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    }
  },
  "required": [
    "name",
    "owner"
  ]
}
