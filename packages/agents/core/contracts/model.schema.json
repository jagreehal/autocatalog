{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "default": "active",
      "type": "string",
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "retired"
      ]
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "discovery": {
      "type": "object",
      "properties": {
        "confidence": {
          "default": "inferred",
          "type": "string",
          "enum": [
            "inferred",
            "reviewed"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "minLength": 1
              },
              "line": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "symbol": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "file",
              "line"
            ]
          }
        },
        "needs_review": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "adapter"
      ]
    },
    "kind": {
      "default": "model",
      "type": "string",
      "const": "model"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "context_window": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "cost_per_million_input_tokens": {
      "type": "number",
      "minimum": 0
    },
    "cost_per_million_output_tokens": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "name",
    "owner",
    "provider",
    "model_id"
  ]
}
