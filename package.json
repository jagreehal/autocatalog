{
  "name": "autocatalog-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "prettier --check . && oxlint --disable-nested-config",
    "lint:slop": "oxlint --disable-nested-config",
    "typecheck": "node scripts/typecheck.mjs",
    "test:python": "cd python/autocatalog-py && python3 -m pytest -q",
    "release:check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm smoke:product && pnpm validate:events",
    "validate:events": "tsx packages/events/cli/src/bin.ts validate --cwd fixtures/event-starter",
    "validate:agents": "tsx packages/agents/cli/src/bin.ts validate starters/agent-default",
    "validate:docs": "tsx packages/events/cli/src/bin.ts docs check examples/docs-demo/repos",
    "ac:events": "tsx packages/events/cli/src/bin.ts",
    "ac:agents": "tsx packages/agents/cli/src/bin.ts",
    "impact:refund": "tsx packages/agents/cli/src/bin.ts impact agent/refund-agent --root starters/agent-default",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "smoke:describe": "tsx scripts/smoke-describe.ts",
    "smoke:cost": "tsx scripts/smoke-cost.ts",
    "smoke:audit": "tsx scripts/smoke-audit.ts",
    "smoke:drift": "tsx scripts/smoke-drift.ts",
    "drift:starter": "tsx packages/agents/cli/src/bin.ts drift scripts/sample-otlp.json --root starters/agent-default",
    "llmstxt:agents": "tsx packages/agents/cli/src/bin.ts llmstxt --root starters/agent-default",
    "cost:agents": "tsx packages/agents/cli/src/bin.ts cost --by-model --root starters/agent-default",
    "audit:agents": "tsx packages/agents/cli/src/bin.ts audit --root starters/agent-default",
    "site:docs:dev": "pnpm --filter @autocatalog-example/docs dev",
    "site:docs:build": "pnpm --filter @autocatalog-example/docs build",
    "docs:dev": "pnpm --filter autocatalog-site dev",
    "docs:build": "pnpm --filter autocatalog-site build",
    "docs:check": "pnpm --filter autocatalog-site check",
    "smoke:e2e": "bash scripts/e2e-smoke.sh",
    "smoke:product": "node scripts/smoke-product.mjs",
    "smoke:pack": "bash scripts/pack-smoke.sh",
    "experiment": "pnpm -s build && node experiments/run.mjs",
    "experiments": "pnpm -s build && node experiments/run.mjs",
    "compat:eventcatalog": "bash scripts/eventcatalog-compat.sh",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.0",
    "@shadcn/lint": "0.2.1",
    "executable-stories-playwright": "8.11.0",
    "executable-stories-vitest": "8.10.2",
    "oxlint": "1.87.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=24"
  }
}
