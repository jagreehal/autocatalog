# Example env for autocatalog-agents. Copy to .env (gitignored) and edit.
# These are all optional — defaults are fine for most setups.

# Override the per-Agent cost ceiling (audit P1 `cost-ceiling-exceeded`).
# Default: 5000 (USD/month).
# AGENTCATALOG_COST_CEILING_USD=5000

# Override the per-Domain cost ceiling (audit P1 `domain-cost-ceiling-exceeded`).
# Default: 20000 (USD/month).
# AGENTCATALOG_DOMAIN_COST_CEILING_USD=20000

# Point the Astro site at a non-default catalog root (otherwise resolves to starters/default).
# CATALOG_ROOT=/absolute/path/to/your/catalog
