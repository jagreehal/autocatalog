{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".astro/**"],
      "passThroughEnv": ["AUTOCATALOG_DOCS_LINKS"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/fixtures/**",
        "!$TURBO_ROOT$/fixtures/**/node_modules/**",
        "$TURBO_ROOT$/examples/federation/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/starters/**"
      ],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
