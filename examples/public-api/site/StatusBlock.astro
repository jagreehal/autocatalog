---
// A block of this site's own, named `status` in layouts.home.
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<section class="not-content status">
  <p>All systems operational. <a href={href}>See the status page</a>.</p>
</section>

<style>
  .status {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    padding: 1rem 1.25rem;
  }
</style>
