{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaymentCompleted",
  "description": "A payment settled with the card network.",
  "type": "object",
  "properties": {
    "amount": {
      "type": "number",
      "format": "double"
    },
    "currency": {
      "type": "string"
    },
    "paymentId": {
      "type": "string"
    }
  },
  "required": [
    "paymentId",
    "amount",
    "currency"
  ],
  "x-autocatalog": {
    "consumers": [
      "LedgerService"
    ],
    "domain": "payments",
    "id": "payment.completed",
    "producers": [
      "PaymentService"
    ],
    "version": "1.0.0"
  }
}
