          "link": "?path=/story/design-system-button--primary"
        },
        {
          "id": "design-system-button--secondary",
          "name": "Secondary",
          "description": "Every other action.",
          "snippet": "const Secondary = () => <Button label=\"Cancel\" variant=\"secondary\" />;",
          "link": "?path=/story/design-system-button--secondary"
        }
      ]
    },
    {
      "id": "design-system-errorbanner",
      "name": "ErrorBanner",
