---
// The front door, per reader: it replaces the built-in home page, and renders
// per request so each account sees the guides on its plan.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { CardGrid, LinkCard } from '@astrojs/starlight/components';
import { getCollection } from 'astro:content';
import { docHref } from 'autocatalog-docs-astro/docs';

export const prerender = false;

const { reader, canRead } = Astro.locals;

const guides = (await getCollection('docs')).filter((entry) => canRead?.(entry));
---

<StarlightPage
  frontmatter={{
    title: reader ? `Welcome back, ${reader.name}` : 'Acme Help',
    description: reader ? 'The guides for your plan.' : 'Sign in to see the guides for your plan.',
    tableOfContents: false,
  }}
>
  <CardGrid>
    {
      guides.map((entry) => (
        <LinkCard
          title={entry.data.title}
          description={entry.data.summary}
          href={`${docHref(entry.id)}/`}
        />
      ))
    }
  </CardGrid>
</StarlightPage>
