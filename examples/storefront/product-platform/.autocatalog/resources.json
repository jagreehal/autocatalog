          "type": "object",
          "properties": {
            "productId": {
              "description": "Unique identifier of the product to delete",
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "description": "Optional reason the product is being removed",
              "type": "string",
              "enum": ["DISCONTINUED", "DUPLICATE", "MERCHANT_REQUEST", "OTHER"]
            }
          },
          "required": ["productId"]
        },
        "transport": [],
