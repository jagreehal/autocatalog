{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShipmentFailed",
  "description": "Published when a shipment could not be delivered",
  "type": "object",
  "properties": {
    "shipmentId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": ["FAILED_DELIVERY", "LOST", "DAMAGED", "RETURNED_TO_SENDER"]
    },
    "failedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["shipmentId", "orderId", "reason", "failedAt"],
  "x-autocatalog": {
    "id": "shipment-failed",
    "version": "1.0.0",
    "domain": "fulfilment",
    "name": "Shipment Failed",
    "summary": "Published by the carrier when a shipment could not be delivered.",
    "producers": ["Tracking API"]
  }
}
