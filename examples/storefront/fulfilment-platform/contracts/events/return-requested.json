{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReturnRequested",
  "description": "Published when a customer has requested a return",
  "type": "object",
  "properties": {
    "returnId": {
      "type": "string",
      "format": "uuid"
    },
    "orderId": {
      "type": "string",
      "format": "uuid"
    },
    "customerId": {
      "type": "string",
      "format": "uuid"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": ["sku", "quantity"]
      }
    },
    "reason": {
      "type": "string"
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["returnId", "orderId", "customerId", "items", "requestedAt"],
  "x-autocatalog": {
    "id": "return-requested",
    "version": "1.0.0",
    "domain": "returns",
    "name": "Return Requested",
    "summary": "Published when a customer has requested to return items from an order.",
    "producers": ["Returns API"],
    "consumers": ["Returns Processor"],
    "transport": [
      {
        "address": "fulfilment.returns",
        "protocols": ["kafka"]
      }
    ],
    "delivery": {
      "guarantee": "at-least-once"
    }
  }
}
