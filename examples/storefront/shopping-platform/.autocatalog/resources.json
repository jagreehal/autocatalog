      "tags": [],
      "provenance": {
        "default": "declared",
        "fields": {}
      },
      "needsReview": false,
      "attributes": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "title": "AddItemToCart",
          "description": "Command to add an item to a shopping cart",
          "type": "object",
          "properties": {
            "cartId": {
              "description": "Unique identifier of the cart",
              "type": "string",
              "format": "uuid"
            },
            "productId": {
              "description": "Identifier of the product to add",
              "type": "string",
              "format": "uuid"
            },
            "quantity": {
              "description": "Number of units to add",
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          "required": ["cartId", "productId", "quantity"]
        },
        "transport": [],
        "outcome": null,
        "outcomeSchema": null
      },
      "summary": "Command to add an item to a shopping cart.",
      "source": {
        "type": "code",
        "file": "commands/add-item-to-cart/autocatalog.json"
      }
    },
    {
      "ref": {
        "kind": "command",
        "namespace": "shopping",
        "id": "calculate-discount",
        "version": "1.0.0"
      },
      "title": "Calculate Discount",
      "tags": [],
      "provenance": {
        "default": "declared",
        "fields": {}
      },
      "needsReview": false,
      "attributes": {
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "title": "CalculateDiscount",
          "description": "Command to calculate the discount for a cart, and the discount returned",
          "type": "object",
          "properties": {
            "request": {
              "type": "object",
              "properties": {
                "cartId": {
                  "type": "string",
                  "format": "uuid"
                },
                "customerId": {
                  "type": "string",
                  "format": "uuid"
                },
                "subtotal": {
                  "description": "Cart subtotal before discounts, in minor units (e.g. cents)",
                  "type": "integer",
                  "minimum": 0
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "promotionCode": {
                  "description": "Optional promotion code supplied by the customer",
                  "type": "string"
                }
              },
              "required": ["cartId", "subtotal", "currency"]
            },
            "response": {
              "type": "object",
              "properties": {
                "discount": {
                  "description": "Total discount to apply, in minor units (e.g. cents)",
                  "type": "integer",
                  "minimum": 0
                },
                "appliedPromotions": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": ["discount"]
            }
          },
          "required": ["request", "response"]
        },
        "transport": [
          {
            "address": "shopping-discount-commands",
            "protocols": ["sqs"]
          }
        ],
        "outcome": null,
        "outcomeSchema": null
      },
      "summary": "Command to calculate the discount that applies to a cart.",
      "source": {
        "type": "code",
        "file": "commands/calculate-discount/autocatalog.json"
      }
    },
