{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["paymentId", "amount", "status"],
  "properties": {
    "paymentId": { "type": "string", "description": "Unique across every payment Acme takes." },
    "amount": { "type": "integer", "description": "In the currency's minor unit." },
    "currency": { "type": "string", "description": "ISO 4217." },
    "status": { "type": "string", "enum": ["authorised", "captured", "refunded"] }
  }
}
