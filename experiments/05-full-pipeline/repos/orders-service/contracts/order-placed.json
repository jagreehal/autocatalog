{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order placed",
  "description": "A customer placed an order.",
  "type": "object",
  "required": ["orderId", "total", "currency"],
  "properties": {
    "orderId": { "type": "string" },
    "total": { "type": "number", "description": "Order total in major units." },
    "currency": { "type": "string", "enum": ["GBP", "EUR"] },
    "giftMessage": { "type": "string", "description": "Printed on the invoice." }
  },
  "x-autocatalog": {
    "id": "order.placed",
    "version": "1.1.0",
    "domain": "orders",
    "producers": ["OrderService"],
    "consumers": ["BillingService", "AnalyticsService"],
    "consumerFields": { "BillingService": ["orderId", "total", "currency"] },
    "transport": [{ "address": "orders.events", "deliveryMode": "push" }]
  }
}
